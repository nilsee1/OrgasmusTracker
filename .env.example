# ==============================================================================
# Telegram Orgasmus-Tracker Bot - Konfiguration
# ==============================================================================

# Erforderlich: Dein Telegram Bot Token von @BotFather
# Beispiel: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Erforderlich: Komma-separierte Liste der erlaubten Telegram User-IDs
# Der Bot reagiert AUSSCHLIESSLICH auf Anfragen von diesen IDs.
# Finde deine User-ID z.B. mit dem Bot @userinfobot heraus oder starte diesen Bot
# (er zeigt dir bei unbefugtem Zugriff deine aktuelle ID an).
# Beispiel für einen Nutzer: ALLOWED_USER_IDS=123456789
# Beispiel für mehrere Nutzer: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=123456789

# Optional: Pfad zur SQLite-Datenbankdatei
# Im Docker-Container ist der Standardpfad /app/data/tracker.db gemountet.
# Für lokale Entwicklung außerhalb von Docker kannst du z.B. ./data/tracker.db nutzen.
DB_PATH=/app/data/tracker.db

# Optional: Zeitzone für Zeitstempel und Berechnungen (Standard: Europe/Berlin)
TZ=Europe/Berlin

